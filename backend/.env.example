ENVIRONMENT=development
# Admin/owner connection — used only for migrations and seeding (bypasses RLS).
DATABASE_URL=postgresql+asyncpg://helpdesk:helpdesk@localhost:5432/helpdesk
# Password for the least-privilege app_runtime role the app connects as at
# request time (RLS-enforced). Migrations create/sync this role using the
# same value. Change it for any non-local environment.
APP_DB_PASSWORD=app_dev_password
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
# Model used by the agent. Chosen by the evals (M8); cost table lives in app/llm/pricing.py.
OPENAI_MODEL=gpt-5-mini
# minimal | low | medium | high. Default low: half the latency and cost of medium, same pass rate on the
# evals (docs/evals.md). Set it EMPTY for a model that does not reason (gpt-4.1-mini, other providers).
OPENAI_REASONING_EFFORT=low
# Any OpenAI-compatible endpoint (DeepSeek, Kimi, OpenRouter, a local server). Empty = OpenAI.
# Prices for other providers must be added to app/llm/pricing.py, or costs show as 0.
OPENAI_BASE_URL=
AGENT_MAX_STEPS=6
CORS_ORIGINS=["http://localhost:5173"]
# Seconds the per-conversation lock lives; renewed before every model call.
CONVERSATION_LOCK_TTL_SECONDS=120
# Knowledge-base embeddings. Configured apart from chat: not every chat provider serves embeddings.
# EMBEDDING_PROVIDER=hashing needs no key (free, lexical only: for local development and tests).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY falls back to OPENAI_API_KEY; EMBEDDING_BASE_URL empty = OpenAI.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Below this cosine similarity (and with no all-words match) a passage counts as unrelated.
KB_MIN_SIMILARITY=0.3

# --- Public demo protection (ADR 0007) ---
# header = no authentication (local development). signed = Bearer tokens from POST /api/demo/session.
# ENVIRONMENT=production refuses to start unless AUTH_MODE=signed and DEMO_TOKEN_SECRET is 32+ characters.
AUTH_MODE=header
DEMO_TOKEN_SECRET=
DEMO_TOKEN_TTL_HOURS=12
# Only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_FORWARDED_FOR=false
# USD caps (0 = off): whole demo per day, one IP per day, one session.
DAILY_BUDGET_USD=1.00
IP_DAILY_BUDGET_USD=0.25
SESSION_BUDGET_USD=0.10
