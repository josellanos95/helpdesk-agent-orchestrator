ENVIRONMENT=development
# Admin/owner connection — used only for migrations and seeding (bypasses RLS).
DATABASE_URL=postgresql+asyncpg://helpdesk:helpdesk@localhost:5432/helpdesk
# Password for the least-privilege app_runtime role the app connects as at
# request time (RLS-enforced). Migrations create/sync this role using the
# same value. Change it for any non-local environment.
APP_DB_PASSWORD=app_dev_password
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
CORS_ORIGINS=["http://localhost:5173"]
